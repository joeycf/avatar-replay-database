# YouTube Data API v3 key — scripts/fetch.ts and scripts/fetch-theater.ts only.
# Read from env, never logged, never committed. In CI it comes from the repo
# secret of the same name (.github/workflows/data-refresh.yml).
#
# Quota note, and it is the reason checklist 10j exists: this key is SHARED with
# six other games' daily crons. The Avatar backfill is small (~32 intake
# channels, a few thousand playlistItems pages at 1 unit each plus hydration),
# but a recon pass here once spent 1,200 units on twelve search.list calls and
# exhausted the shared daily quota for every repo. Never page anything with
# search.list, and run a backfill after the day's crons have finished.
YT_API_KEY=

# Canonical origin for SEO/OG/sitemap. Production sets this on the Vercel
# project; locally it falls back to the app.config value.
NUXT_PUBLIC_SITE_URL=https://replaydatabase.com

# Local engine co-development: nuxt.config extends this path when set; Vercel
# leaves it UNSET and pulls the pinned github: tag. It must never ride a
# deployment — see .vercelignore.
ENGINE_PATH=../replay-engine

# Base path override for special builds (e.g. NUXT_APP_BASE_URL=/ for a
# root-based local preview). The committed default in nuxt.config IS the
# production truth: Avatar is born behind the shell at replaydatabase.com/avatar.
# NEVER copy this value from a sibling project's Vercel env — checklist 10h:
# one game shipped its first build mounted at the previous game's base path
# because NUXT_APP_BASE_URL came along with a copied env.
# NUXT_APP_BASE_URL=/avatar/

# Post-deploy smoke check (scripts/verify-deployed.ts). SMOKE_HOST defaults to
# the apex; point it at the game's own *.vercel.app before the shell flip.
# SMOKE_HOST=https://avatar-replay-database.vercel.app
# SMOKE_TIMEOUT_SEC=900
# SMOKE_INTERVAL_SEC=20
